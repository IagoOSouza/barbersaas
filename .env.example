# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o Git!

# Flask
SECRET_KEY=troque-por-uma-chave-secreta-longa
FLASK_ENV=development
FLASK_DEBUG=1

# Banco de dados (Supabase)
# Pegue no painel do Supabase em: Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:SENHA@db.REFERENCIA.supabase.co:5432/postgres

# JWT
JWT_SECRET_KEY=outra-chave-secreta-diferente-da-de-cima

# WhatsApp (Z-API ou Evolution API)
WHATSAPP_API_URL=https://api.z-api.io/instances/SEU_ID/token/SEU_TOKEN
WHATSAPP_TOKEN=seu-token-aqui
